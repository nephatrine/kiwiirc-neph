{
    "name": "kiwiirc-desktop",
    "version": "2.2.0",
    "private": true,
    "description": "Kiwi IRC Electron Shell",
    "homepage": "https://code.nephatrine.net/nephatrine/kiwiirc",
    "bugs": {
        "url": "https://code.nephatrine.net/nephatrine/kiwiirc/issues"
    },
    "license": "ISC",
    "author": "Daniel Wolf <nephatrine@gmail.com>",
    "main": "electron/main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --dev",
        "icons": "node scripts/build-icons.js",
        "pack": "electron-builder --dir",
        "dist:linux": "electron-builder --linux AppImage",
        "dist:linux:deb": "electron-builder --linux deb",
        "dist:win": "electron-builder --win portable",
        "dist:all": "npm run dist:linux && npm run dist:win"
    },
    "dependencies": {
        "json5": "^2.2.3"
    },
    "devDependencies": {
        "electron": "^45.2.3",
        "electron-builder": "^26.18.0"
    },
    "desktopName": "kiwiirc-desktop"
}
