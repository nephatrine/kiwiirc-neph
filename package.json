{
    "name": "kiwiirc-neph",
    "version": "2.2.0",
    "description": "WebIRC Client",
    "homepage": "https://code.nephatrine.net/nephatrine/kiwiirc",
    "bugs": {
        "url": "https://code.nephatrine.net/nephatrine/kiwiirc/issues"
    },
    "license": "Apache-2.0",
    "author": "Darren <darren@darrenwhitlen.com>",
    "contributors": [
        {
            "name": "Daniel Wolf",
            "email": "nephatrine@gmail.com",
            "url": "https://nephatrine.net/"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://code.nephatrine.net/nephatrine/kiwiirc"
    },
    "scripts": {
        "build": "vue-cli-service build --no-module",
        "build:release": "vue-cli-service build --no-module --nomap",
        "postbuild": "node scripts/minify-static.js",
        "generate:emojis": "node scripts/generate-emojis.js",
        "generate:boxicons": "node scripts/generate-boxicons-css.js",
        "generate:fish-vectors": "python3 scripts/fish-vectors.py",
        "optimize:bongo": "node scripts/optimize-bongo-images.js",
        "format": "npm-run-all format:*",
        "format:eslint": "eslint --fix src tests scripts static/plugins desktop/electron desktop/scripts \"*.js\" \".*.js\"",
        "format:md": "mdformat *.md desktop/*.md static/plugins/*.md",
        "format:stylelint": "stylelint --fix \"src/**/*.{vue,htm,html,css,sss,less,scss}\" \"static/themes/**/*.css\" \"static/plugins/**/*.css\" \"static/plugins/**/*.html\"",
        "check:md": "mdformat --check *.md desktop/*.md static/plugins/*.md",
        "test:unit": "jest",
        "lint": "npm-run-all lint:*",
        "lint:eslint": "eslint src tests scripts static/plugins desktop/electron desktop/scripts \"*.js\" \".*.js\"",
        "lint:stylelint": "stylelint \"src/**/*.{vue,htm,html,css,sss,less,scss}\" \"static/themes/**/*.css\" \"static/plugins/**/*.css\" \"static/plugins/**/*.html\"",
        "dev": "vue-cli-service serve",
        "test": "jest",
        "gendocs": "rm -rf srcdocs/ && jsdoc -c jsdoc.json"
    },
    "dependencies": {
        "@babel/runtime": "^8.0.5",
        "@panter/vue-i18next": "^0.15.2",
        "boxicons": "^2.1.4",
        "buffer": "^6.0.3",
        "eventemitter3": "^5.0.1",
        "i18next": "^25.10.10",
        "i18next-http-backend": "^4.0.3",
        "irc-framework": "^4.14.0",
        "json5": "^2.2.3",
        "sockjs-client": "^1.6.1",
        "stream-browserify": "^3.0.0",
        "strftime": "^0.10.3",
        "tinycon": "^0.6.8",
        "vue": "^2.7.16",
        "vue-virtual-scroller": "^1.1.2"
    },
    "devDependencies": {
        "@babel/core": "^7.28.0",
        "@babel/eslint-parser": "^7.29.9",
        "@babel/plugin-transform-runtime": "^7.28.0",
        "@stylistic/stylelint-plugin": "^5.3.1",
        "@vue/cli-plugin-babel": "~5.0.9",
        "@vue/cli-service": "~5.0.9",
        "@vue/test-utils": "2.4.6",
        "@vue/vue2-jest": "^29.2.6",
        "babel-jest": "^29.7.0",
        "copy-webpack-plugin": "^14.0.0",
        "cssnano": "^5.1.15",
        "eslint": "^9.39.5",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-vue": "^10.11.1",
        "eslint-plugin-vuejs-accessibility": "^2.6.2",
        "globals": "^17.13.0",
        "html-loader": "^5.1.0",
        "html-minifier-terser": "^7.2.0",
        "i18next-conv": "^15.1.1",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jsdoc": "^4.0.5",
        "less": "^4.9.1",
        "less-loader": "^12.3.0",
        "neostandard": "^0.14.1",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.28",
        "postcss-html": "^2.0.0",
        "postcss-import": "^16.1.1",
        "postcss-url": "^10.1.3",
        "stylelint": "^17.16.0",
        "stylelint-config-html": "^2.0.0",
        "stylelint-config-recommended-scss": "^17.0.1",
        "stylelint-config-recommended-vue": "^2.0.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-webpack-plugin": "^5.1.0",
        "terser": "^5.51.2",
        "vue-eslint-parser": "^10.4.1",
        "vue-template-compiler": "^2.7.16",
        "webpack": "^5.101.0"
    },
    "overrides": {
        "@ungap/structured-clone": "^1.4.0",
        "js-beautify": {
            "editorconfig": "^4.0.1",
            "glob": "^14.0.6"
        },
        "serialize-javascript": "^7.1.4",
        "sockjs": {
            "uuid": "^11.1.1"
        }
    },
    "engines": {
        "node": ">= 22.0.0"
    }
}
